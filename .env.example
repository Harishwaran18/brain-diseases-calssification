# Sample environment configuration. Copy to .env and fill in as needed.
# All values are optional; the pipeline falls back to sensible defaults.

# Device override: "cuda", "cpu", or "mps". If unset, auto-detected.
BRAINFRAME_DEVICE=cpu

# Directory for downloaded SAM checkpoints (default: data/checkpoints).
BRAINFRAME_CHECKPOINT_DIR=data/checkpoints

# SAM model type: vit_h, vit_l, vit_b (default: vit_b for speed).
BRAINFRAME_SAM_MODEL_TYPE=vit_b

# Hugging Face / direct SAM checkpoint URL override (optional).
# BRAINFRAME_SAM_CHECKPOINT_URL=

# OASIS-1 data root (downloaded separately; see docs/reproducibility.md).
# BRAINFRAME_OASIS_ROOT=

# BraTS data root (optional).
# BRAINFRAME_BRTS_ROOT=

# Random seed for reproducibility (default: 42).
BRAINFRAME_SEED=42

# Logging level: DEBUG, INFO, WARNING, ERROR (default: INFO).
BRAINFRAME_LOG_LEVEL=INFO
